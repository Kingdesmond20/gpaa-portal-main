# Supabase project (backend for the member portal: auth, database, storage).
# Both are safe to expose to the browser — the anon key only works within
# the Row-Level Security policies defined in supabase/migrations. Find them
# in Supabase Dashboard → Project Settings → API. See lib/supabaseClient.ts.
# NEVER put the service_role key in a VITE_ var — it bypasses RLS entirely
# and belongs only in Supabase Edge Function secrets (see supabase/README.md).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Paystack public key — safe to expose to the browser (it can only start a
# checkout, never move money on its own). The secret key that actually
# verifies payments is a Supabase Edge Function secret only (PAYSTACK_SECRET_KEY,
# see supabase/README.md), never a VITE_ var. Find this in the Paystack
# Dashboard → Settings → API Keys & Webhooks — use a test key until you're
# ready to accept real payments.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
